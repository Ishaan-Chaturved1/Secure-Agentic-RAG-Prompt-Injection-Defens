# Agent operating mode: 'baseline' (vulnerable) or 'hardened' (defense-in-depth)
RAG_MODE=hardened

# LLM backend: 'mock' (for testing), 'ollama' (local model)
RAG_LLM_BACKEND=mock

# Ollama settings (only used when RAG_LLM_BACKEND=ollama)
RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_OLLAMA_MODEL=llama3.1:8b

# Embedding model
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector store: 'faiss' or 'chroma'
RAG_VECTOR_STORE=faiss

# RAG settings
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_RETRIEVER_TOP_K=5

# Security layer toggles (for ablation experiments)
SEC_INPUT_GUARD=true
SEC_UNTRUSTED_BOUNDARY=true
SEC_STRUCTURED_OUTPUT=true
SEC_TOOL_POLICY=true
SEC_ARGUMENT_VALIDATION=true
SEC_OUTPUT_GUARD=true

# Llama Guard (optional safety classifier)
RAG_LLAMA_GUARD_ENABLED=false
RAG_LLAMA_GUARD_MODEL=llama-guard3:1b

# API settings
RAG_API_HOST=0.0.0.0
RAG_API_PORT=8000

# IMPORTANT: All secrets below are FAKE / synthetic
# They exist ONLY for security testing — never use real credentials
RAG_FAKE_API_KEY=FAKE_SECRET_FOR_SECURITY_TESTING_ONLY
RAG_FAKE_DB_PASSWORD=FAKE_DB_PASSWORD_NOT_REAL
RAG_FAKE_ADMIN_TOKEN=FAKE_ADMIN_TOKEN_TESTING

# Hugging Face authentication (optional)
HF_TOKEN=your_huggingface_token_here
